<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
    <PropertyGroup>
        <Version>0.0.0.18</Version>
        <Description>Share opt-in enemy, event and treasure observations from Eureka, Bozja, Zadnor and Occult Crescent. Open /xivforays config for settings.</Description>
        <PackageProjectUrl>https://github.com/XivMate/XivForays</PackageProjectUrl>
        <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
        <IsPackable>false</IsPackable>
        <RootNamespace>XivMate.DataGathering.Forays.Dalamud</RootNamespace>
        <PackageId>XivForays.Plugin</PackageId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.3"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.3"/>
    </ItemGroup>

    <!-- DEVELOPER-ONLY value scanner. Compiled only with -p:DevScanner=true. The published Release build never
         sets it, so Dev\ is not even compiled and no scanner type reaches the released dll. -->
    <PropertyGroup Condition="'$(DevScanner)' == 'true'">
        <DefineConstants>$(DefineConstants);DEV_SCANNER</DefineConstants>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup Condition="'$(DevScanner)' != 'true'">
        <Compile Remove="Dev\**" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Gathering\System\"/>
    </ItemGroup>
</Project>
