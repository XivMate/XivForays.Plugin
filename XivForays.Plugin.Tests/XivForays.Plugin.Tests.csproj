<Project Sdk="Microsoft.NET.Sdk">
    <!--
      Offline tests for the plugin's dependency-free logic. The Dalamud plugin assembly itself cannot be
      loaded outside the game, so the pure sources (Core/*.cs and the Observation model) are compiled in
      directly. The game-sheet test additionally references Lumina from the local Dalamud install
      (DALAMUD_HOME or %AppData%\XIVLauncher\addon\Hooks\dev) and reads a local game install when present.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <Platforms>x64</Platforms>
        <PlatformTarget>x64</PlatformTarget>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RootNamespace>XivForays.Plugin.Tests</RootNamespace>
    </PropertyGroup>

    <PropertyGroup>
        <LuminaDir Condition="'$(DALAMUD_HOME)' != ''">$([MSBuild]::EnsureTrailingSlash('$(DALAMUD_HOME)'))</LuminaDir>
        <LuminaDir Condition="'$(LuminaDir)' == ''">$(AppData)\XIVLauncher\addon\Hooks\dev\</LuminaDir>
        <DefineConstants Condition="Exists('$(LuminaDir)Lumina.dll') And Exists('$(LuminaDir)Lumina.Excel.dll')">$(DefineConstants);HAS_LUMINA</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="..\XivForays.Plugin\Core\*.cs" Link="Plugin\Core\%(Filename)%(Extension)" />
        <Compile Include="..\XivForays.Plugin\Models\Observation.cs" Link="Plugin\Models\Observation.cs" />
        <Compile Include="..\XivForays.Plugin\Models\PoseRecords.cs" Link="Plugin\Models\PoseRecords.cs" />
        <Compile Include="..\XivForays.Plugin\Models\PlayerContext.cs" Link="Plugin\Models\PlayerContext.cs" />
        <!-- Only the dependency-free part of the plugin Configuration (the per-content recording toggles). -->
        <Compile Include="..\XivForays.Plugin\Configuration\Configuration.Recording.cs" Link="Plugin\Configuration\Configuration.Recording.cs" />
        <!-- The collector overlay settings (0.0.0.16), dependency-free like the recording toggles. -->
        <Compile Include="..\XivForays.Plugin\Configuration\Configuration.Overlay.cs" Link="Plugin\Configuration\Configuration.Overlay.cs" />
    </ItemGroup>

    <ItemGroup Condition="Exists('$(LuminaDir)Lumina.dll') And Exists('$(LuminaDir)Lumina.Excel.dll')">
        <Reference Include="Lumina" HintPath="$(LuminaDir)Lumina.dll" Private="true" />
        <Reference Include="Lumina.Excel" HintPath="$(LuminaDir)Lumina.Excel.dll" Private="true" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
        <PackageReference Include="Xunit.SkippableFact" Version="1.4.13" />
        <!-- Dalamud saves plugin configs with Newtonsoft.Json: the default-true load test reads a 0.0.0.14 config with it. -->
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    </ItemGroup>
</Project>
